# =====================================================================
# Modèle des variables d'environnement. Copier en .env.local (jamais commité).
# Ne JAMAIS coller une vraie clé dans ce fichier ni dans une conversation.
# =====================================================================

# --- Publiques (envoyées au navigateur : aucun secret ici) -------------
# Adresse officielle du site (https://…, sans barre finale), lue au build.
# Facultative sur Vercel : sans elle, l'adresse fournie automatiquement par
# Vercel est utilisée (ina-africa.vercel.app en production, adresse de la
# branche en prévisualisation) ; ailleurs, http://localhost:3000.
# Sur Vercel, ne la renseigner QUE pour l'environnement Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mettre exactement "true" à la mise en ligne pour autoriser Google (lu au build :
# changer la valeur demande un nouveau build). Vide = site non indexé.
# Production seulement : un déploiement de prévisualisation Vercel n'est jamais indexé.
SITE_INDEXABLE=

# --- Secrètes (serveur uniquement) -------------------------------------
# Clé secrète Supabase (Project Settings → API Keys → Secret key).
# Contourne les règles RLS : serveur uniquement.
SUPABASE_SECRET_KEY=sb_secret_...

# Sel des empreintes d'adresse IP (anti-abus). 32 caractères minimum.
# Générer avec : openssl rand -hex 32
IP_HASH_SECRET=

# Adresses qui reçoivent les formulaires, séparées par des virgules.
NOTIFICATION_EMAILS=

# --- Services branchés plus tard (laisser vides) -----------------------
# Anti-robot Cloudflare Turnstile : actif seulement si les DEUX clés sont renseignées.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Emails (Resend) : actifs seulement si la clé ET l'expéditeur sont renseignés.
# Expéditeur d'un domaine vérifié chez Resend, ex. : INA-AFRICA <contact@ina-africa.org>
RESEND_API_KEY=
EMAIL_FROM=
# Paiement KKiaPay. Mode TEST (aucun argent réel, rien d'enregistré) :
# clé publique Sandbox + KKIAPAY_SANDBOX=true. Mode RÉEL (après validation du
# compte marchand) : les 3 clés Live et KKIAPAY_SANDBOX vide ou false.
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
KKIAPAY_SANDBOX=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
# Secret du webhook (KKiaPay → Développeurs → Webhook), adresse :
# https://<site>/api/paiements/notification
KKIAPAY_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
